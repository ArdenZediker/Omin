# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build outputs
dist
dist-ssr
# 构建冒烟测试用的临时输出目录（vite build --outDir dist-check*）
dist-check*/
output
src-tauri/target
src-tauri/gen/schemas

# file-viewer vite 插件 dev 模式生成的可再生资源（worker/wasm/字体，~25MB，构建时自动重新拷贝）
public/vendor/
public/flyfish-viewer-assets.json

# Local environment and secrets
*.local
.env
.env.*
!.env.example

# Tauri / Rust local files
**/*.rs.bk
# 临时 cargo 编译目录（沙箱/验证用，非项目产物）
# 用通配一次性覆盖所有编号变体，避免再次漏写导致构建产物误入库。
target_check/
target_check*/
target_verify/
target_fresh/
target_sandbox*/
target_skillhub_fix/
cargo_check.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# WorkBuddy 本地项目数据（记忆/技能/MCP 配置等，不入库）
.workbuddy/
